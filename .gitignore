# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust / Tauri build artifacts
/src-tauri/target
/src-tauri/gen/schemas

# THE PRIVATE WORKSPACE — local only, never committed, never pushed, never published.
#
# Everything internal lives here: plans, reports, investigations, evidence, checkpoints and working
# notes. Nothing in it is part of the product, and nothing in it may reach a public repository or a
# release artifact.
#
# This rule is a LOCAL boundary and deliberately not the only one. It stops the material being
# committed at all; the production-tree and production-content gates independently refuse it from any
# published snapshot. Two independent controls, because the release pipeline must not depend on a
# single ignore line being correct.
/private/

# Local build output.
/test-build/

# Env
.env
.env.*

# Kept as a backstop so a stray local copy can never be committed.
/PROJECT.md

# NOTE: `/docs/` is deliberately NOT ignored — GitHub Pages serves the published project site from
# it on the default branch.

# RESILIENCE-1 / WP-0 — test artefacts.
#
# Generated EPUB fixtures: rebuilt by `npm run fixtures:build`. The GENERATOR is the source of
# truth and is committed; the binaries are not, so a public repo carries no opaque test blobs.
/tests/fixtures/epub/
#
# Test books are third-party copyrighted works and are never committed. Their location comes from
# %SARD_CORPUS%; only the manifest is tracked. This rule is a backstop against copying them in.
/tests/corpus/books/
/corpus/

# Generated comparison output. The tracked baselines beside it are the reference; these files are
# large, per-run, and may name third-party works.
/tests/harness/fingerprints/diff-*.json
/tests/harness/subsystem-runs/

# Scratch build directory. It must sit inside the repository because Node and Vite resolve
# node_modules by walking up from the project directory. Removed after each run; this is a backstop.
/.release-check/

# Large local media samples. Their directory is supplied at run time and falls back to here.
/tests/harness/.media/

# Local database copies. These contain real personal data and must never be committed.
/.db-snapshot-*/
/.zcode/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# No archives in public/. Vite copies public/ verbatim into dist/ and Tauri embeds dist/ into the
# executable, so a stray archive here is compiled into every build and inflates every artifact.
public/**/*.rar
public/**/*.zip
public/**/*.7z
public/**/*.exe
public/**/*.msi
